# Vercel uploads the whole repo. Exclude everything not needed for the static viewer
# or the /api serverless function (which imports codewiki.src.be/fe).

# Local scratch (often 50k+ files — main cause of "too many files" deploy failures)
tmp/
.tmp/
.pytest_cache/

# NOT needed for static viewer or serverless function
benchmarking/
tests/
docker/
docs/
output/
scripts/
/assets/
codewiki.egg-info/

# Tooling / CI / IDE
.cursor/
.agents/
.github/
.idea/
.vscode/

# Node / Playwright
node_modules/
test-results/
demo/playwright/
package-lock.json

# Repo metadata
.git/

# Per-repo codegen: multi-MB JSON dependency graphs the viewer never loads
demo/repos/**/temp/

# Envs
.venv/
venv/
.env*
*.env

# Codewiki areas not needed by api/chat.py
codewiki/cli/
codewiki/mcp/
codewiki/run_web_app.py

# Root requirements.txt is for local dev; Vercel uses api/requirements.txt
requirements.txt
