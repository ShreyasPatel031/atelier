{
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "diagram:watch": "node scripts/run_with_cursor_env.mjs node scripts/diagram_ask_watcher.mjs",
    "demo": "python3 -m http.server 9891 --directory demo",
    "build:viewer": "node demo/scripts/generate-repos-index.js && node demo/scripts/generate-architecture-svgs.js",
    "preview:architecture": "node demo/scripts/generate-architecture-svgs.js --repo persona-selection-model --png",
    "deploy:prod": "vercel --prod --yes",
    "deploy:viewer": "node -e \"const fs=require('fs');fs.copyFileSync('vercel.json','.vercel.deploy-backup.json');fs.copyFileSync('vercel.static.json','vercel.json');\" && vercel --prod --yes && node -e \"const fs=require('fs');fs.copyFileSync('.vercel.deploy-backup.json','vercel.json');fs.rmSync('.vercel.deploy-backup.json');\"",
    "test:elk-diagrams": "node demo/scripts/validate-elk-all-diagrams.js",
    "test:e2e": "playwright test",
    "test:e2e:diagram-help": "node scripts/run_diagram_help_e2e.mjs",
    "test:e2e:edge": "playwright test demo/playwright/edge-hover.spec.ts"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "dompurify": "^3.3.3",
    "elkjs": "^0.9.3",
    "happy-dom": "^20.8.9",
    "jsdom": "^29.0.1",
    "mermaid": "^11.9.0"
  }
}
