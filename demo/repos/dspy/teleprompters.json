{
  "title": "DSPy Teleprompters Module",
  "summary": "This module provides various teleprompters (optimizers) for DSPy programs, enabling automated prompt engineering, few-shot example selection, and program refinement through techniques like evolutionary search, Bayesian optimization, and reinforcement learning.",
  "diagram": {
    "direction": "TD",
    "nodes": [
      {
        "id": "avatar_optimizer",
        "label": "Refine Instructions via Feedback",
        "type": "component",
        "link": null,
        "title": "Avatar Optimizer",
        "description": "Iteratively refines program instructions by analyzing positive and negative execution examples and incorporating feedback."
      },
      {
        "id": "better_together",
        "label": "Orchestrate Optimization Sequence",
        "type": "component",
        "link": null,
        "title": "BetterTogether Meta-Optimizer",
        "description": "A meta-optimizer that combines and sequences various prompt and weight optimization strategies to enhance DSPy programs."
      },
      {
        "id": "copro_optimizer",
        "label": "Iteratively Optimize Signatures",
        "type": "component",
        "link": null,
        "title": "COPRO Optimizer",
        "description": "Optimizes program signatures, including instructions and output field prefixes, through an iterative search process guided by a metric."
      },
      {
        "id": "gepa_optimizer",
        "label": "Evolve Prompts with Reflection",
        "type": "component",
        "link": null,
        "title": "GEPA Evolutionary Optimizer",
        "description": "An evolutionary optimizer that uses reflection on execution traces to propose and evolve improved instructions for program components."
      },
      {
        "id": "grpo_optimizer",
        "label": "Finetune LM via RL",
        "type": "component",
        "link": null,
        "title": "GRPO Finetune Teleprompter",
        "description": "Applies Grouped Reinforcement Learning with Policy Optimization to finetune language models based on program execution traces and associated rewards."
      },
      {
        "id": "infer_rules",
        "label": "Induce & Apply Natural Rules",
        "type": "component",
        "link": null,
        "title": "InferRules Teleprompter",
        "description": "Induces natural language rules from successful program executions and integrates them into predictor instructions."
      },
      {
        "id": "knn_fewshot",
        "label": "Dynamically Select Demos",
        "type": "component",
        "link": null,
        "title": "KNN Few-Shot Selector",
        "description": "Selects the k-nearest neighbor examples from a training set at inference time to dynamically provide few-shot demonstrations."
      },
      {
        "id": "mipro_v2_optimizer",
        "label": "Optimize Prompts with Bayesian Search",
        "type": "component",
        "link": null,
        "title": "MIPROv2 Optimizer",
        "description": "Optimizes program prompt parameters (instructions and few-shot examples) using Bayesian optimization (Optuna) across multiple stages."
      },
      {
        "id": "bootstrap_fewshot_optuna",
        "label": "Select Demos with Optuna",
        "type": "component",
        "link": null,
        "title": "Bootstrap Few-Shot with Optuna",
        "description": "Utilizes Optuna to systematically select the most effective few-shot examples for a program from a bootstrapped pool."
      },
      {
        "id": "dspy_program",
        "label": "DSPy Program",
