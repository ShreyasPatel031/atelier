{
  "title": "Generation Core Module",
  "summary": "This module provides the core logic for auto-regressive text generation, supporting various decoding strategies like greedy, sampling, beam search, and assisted decoding, along with continuous batching capabilities.",
  "diagram": {
    "direction": "LR",
    "nodes": [
      {
        "id": "orchestrate_generation",
        "label": "Orchestrate Generation Flow",
        "type": "component",
        "link": null,
        "title": "Orchestrate Generation Flow",
        "description": "Manages the overall text generation process, handling configuration, input preparation, and dispatching to specific decoding strategies."
      },
      {
        "id": "enable_continuous_batching",
        "label": "Enable Continuous Batching",
        "type": "component",
        "link": null,
        "title": "Enable Continuous Batching",
        "description": "Provides an API for efficient, continuous processing of multiple generation requests, optimizing resource utilization."
      },
      {
        "id": "init_batch_manager",
        "label": "Initialize Batch Manager",
        "type": "component",
        "link": null,
        "title": "Initialize Batch Manager",
        "description": "Sets up the ContinuousBatchingManager with model and generation configurations, preparing it for request handling."
      },
      {
        "id": "manage_batch_lifecycle",
        "label": "Manage Batch Lifecycle",
        "type": "component",
        "link": null,
        "title": "Manage Batch Lifecycle",
        "description": "A context manager that safely initializes, starts, and stops the continuous batching manager, including warmup procedures."
      },
      {
        "id": "prepare_model_inputs",
        "label": "Prepare Model Inputs",
        "type": "component",
        "link": null,
        "title": "Prepare Model Inputs",
        "description": "Transforms raw inputs and model state into the format required for the model's forward pass during generation, including attention masks and KV cache."
      },
      {
        "id": "configure_generation",
        "label": "Configure Generation Parameters",
        "type": "component",
        "link": null,
        "title": "Configure Generation Parameters",
        "description": "Loads, adjusts, and validates generation settings from GenerationConfig and keyword arguments, ensuring consistent behavior."
      },
      {
        "id": "load_custom_logic",
        "label": "Load Custom Generation Logic",
        "type": "component",
        "link": null,
        "title": "Load Custom Generation Logic",
        "description": "Dynamically loads custom `generate` functions from specified Hugging Face Hub repositories or local paths."
      },
      {
        "id": "apply_logits_processing",
        "label": "Apply Logits Processing",
        "type": "component",
        "link": null,
        "title": "Apply Logits Processing",
        "description": "Applies various processors (e.g., repetition penalty, temperature, top-k/p sampling) to raw model output logits before token selection."
      },
      {
        "id": "apply_stopping_criteria",
        "label": "Apply Stopping Criteria",
        "type": "component",
        "link": null,
        "title": "Apply Stopping Criteria",
        "description": "Evaluates conditions (e.g., max length, EOS token, stop strings) to determine when to halt the generation process for a sequence."
      },
      {
        "id": "manage_kv_cache",
        "label": "Manage KV Cache",
        "type": "component",
        "link": null,
        "title": "Manage KV Cache",
        "description": "Initializes and updates the key-value cache (static or dynamic) to store past attention states, improving generation efficiency."
      },
      {
        "id": "perform_sampling",
        "label": "Perform Multinomial Sampling",
        "type": "component",
        "link": null,
        "title": "Perform Multinomial Sampling",
        "description": "Generates tokens by sampling from the probability distribution of the next token, allowing for diverse outputs."
      },
      {
        "id": "perform_beam_search",
        "label": "Perform Beam Search",
        "type": "component",
        "link": null,
        "title": "Perform Beam Search",
        "description": "Generates sequences by exploring multiple high-probability paths simultaneously, aiming for higher quality outputs."
      },
      {
        "id": "perform_assisted_decoding",
        "label": "Perform Assisted Decoding",
        "type": "component",
        "link": null,
        "title": "Perform Assisted Decoding",
        "description": "Accelerates generation by using a smaller assistant model to propose candidate tokens, which are then verified by the main model."
      },
      {
        "id": "validate_generation_params",
        "label": "Validate Generation Parameters",
        "type": "component",
        "link": null,
        "title": "Validate Generation Parameters",
        "description": "Checks for consistency and validity of generation parameters and model-specific keyword arguments."
      },
      {
        "id": "compute_scores",
        "label": "Compute Transition Scores",
        "type": "component",
        "link": null,
        "title": "Compute Transition Scores",
        "description": "Calculates the log probabilities of generated tokens, useful for analyzing sequence quality or reconstructing scores."
      },
      {
        "id": "heal_tokens",
        "label": "Heal Input Tokens",
        "type": "component",
        "link": null,
        "title": "Heal Input Tokens",
        "description": "Adjusts input tokens to ensure proper tokenization and continuation, especially for partial words or subword units."
      },
      {
        "id": "optimize_decode",
        "label": "Optimize Model for Decoding",
        "type": "component",
        "link": null,
        "title": "Optimize Model for Decoding",
