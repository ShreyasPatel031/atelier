{
  "version": 2,
  "buildCommand": "node demo/scripts/generate-repos-index.js",
  "outputDirectory": "demo",
  "installCommand": "pip install -r api/requirements.txt",
  "functions": {
    "api/chat.py": {
      "maxDuration": 60,
      "includeFiles": "demo/repos/**,codewiki/src/**",
      "excludeFiles": "demo/repos/**/temp/**"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/chat.py"
    },
    {
      "src": "/repos/(.*)",
      "dest": "/repos/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
