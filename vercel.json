{
  "version": 2,
  "buildCommand": "node demo/scripts/generate-repos-index.js",
  "outputDirectory": "demo",
  "functions": {
    "api/chat.py": {
      "maxDuration": 60,
      "includeFiles": "demo/repos/**",
      "excludeFiles": "demo/repos/**/temp/**,demo/repos/transformers/**,demo/repos/crewai-src/**,demo/repos/**/architecture.png,demo/repos/**/architecture-legend.png,demo/repos/**/architecture.svg,demo/repos/**/architecture-legend.svg,demo/repos/**/sync_issues.json"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/chat.py"
    },
    {
      "src": "/repos/(.*)",
      "dest": "/repos/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
