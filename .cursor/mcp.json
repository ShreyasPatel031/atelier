{
  "mcpServers": {
    "atelier": {
      "type": "stdio",
      "command": "/bin/bash",
      "args": ["${workspaceFolder}/scripts/run_codewiki_mcp.sh"],
      "cwd": "${workspaceFolder}",
      "env": {
        "CODEWIKI_MCP_PORT": "18765",
        "PYTHONWARNINGS": "ignore::FutureWarning"
      }
    },
    "codewiki-diagram": {
      "type": "stdio",
      "command": "node",
      "args": ["${workspaceFolder}/packages/codewiki-diagram-mcp/dist/index.js"],
      "env": {
        "CODEWIKI_DATA_ORIGIN": "https://app.atelier-inc.net"
      }
    }
  }
}
