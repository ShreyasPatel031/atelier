# One-time setup (never commit the real file — it is gitignored):
#   cp scripts/cursor-sdk.env.example scripts/cursor-sdk.env
#   # edit scripts/cursor-sdk.env and paste your key
#
# Loaded automatically by: npm run diagram:watch, npm run test:e2e:diagram-help
# Key: https://cursor.com/dashboard/integrations

CURSOR_API_KEY=
# Optional default repo for npm run diagram:watch
# DIAGRAM_WATCH_REPO=atelier-tdc8
# SSE port + static demo root for same-origin viewer (default 9878). Open:
#   http://127.0.0.1:9878/?repo=YOUR_REPO
# DIAGRAM_SSE_PORT=9878
# Set to 0 to stop broadcasting sdk_trace over SSE (stdout JSON lines still emit)
# DIAGRAM_SDK_TRACE_SSE=0
